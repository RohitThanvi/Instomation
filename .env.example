# ---- Runtime ----
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated
FRONTEND_BASE_URL=http://localhost:5173

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://instomation:instomation@localhost:5432/instomation
REDIS_URL=redis://localhost:6379/0

# ---- Workers (one process per queue: events | ai | instagram | maintenance) ----
WORKER_QUEUE=maintenance
WORKER_MAX_JOBS=10
WORKER_POLL_DELAY_SECONDS=1.0       # raise on metered Redis hosts to cut idle command usage
JOB_TIMEOUT_SECONDS=120
JOB_MAX_TRIES=5
JOB_RETRY_BASE_SECONDS=1.0
JOB_RETRY_CAP_SECONDS=300
JOB_REQUEUE_AFTER_SECONDS=900       # must exceed JOB_RETRY_CAP_SECONDS
JOB_RETENTION_DAYS=14
WEBHOOK_EVENT_RETENTION_DAYS=30

# ---- Clerk (auth) ----
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=                     # https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=                       # https://<your-clerk-domain>
CLERK_AUTHORIZED_PARTIES=http://localhost:5173   # allowed `azp` origins (frontend URLs)

# ---- Meta / Instagram ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=          # random string you also enter in the Meta dashboard
META_GRAPH_API_VERSION=v26.0
# META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
# META_WEBHOOK_FIELDS=comments,messages
# Operators may switch supported capabilities off per environment:
# FEATURE_COMMENT_REPLY=true
# FEATURE_DM_REPLY=true
# FEATURE_PRIVATE_REPLY=true

# ---- Security ----
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=  # comma-separated old keys, kept only while rotating

# ---- AI providers ----
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=               # optional, e.g. openai
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- Observability ----
SENTRY_DSN=
