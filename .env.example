# ---- Runtime ----
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://instomation:instomation@localhost:5432/instomation
REDIS_URL=redis://localhost:6379/0

# ---- Workers (one process per queue: events | ai | instagram | maintenance) ----
WORKER_QUEUE=maintenance
WORKER_MAX_JOBS=10
# raise on metered Redis hosts to cut idle command usage
WORKER_POLL_DELAY_SECONDS=1.0
JOB_TIMEOUT_SECONDS=120
JOB_MAX_TRIES=5
JOB_RETRY_BASE_SECONDS=1.0
JOB_RETRY_CAP_SECONDS=300
# must exceed JOB_RETRY_CAP_SECONDS
JOB_REQUEUE_AFTER_SECONDS=900
JOB_RETENTION_DAYS=14
WEBHOOK_EVENT_RETENTION_DAYS=30

# ---- Clerk (auth) ----
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=
# https://<your-clerk-domain>
CLERK_ISSUER=
# allowed `azp` origins (frontend URLs)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# ---- Frontend (build-time, public values only) ----
# Browser-reachable URL of the API
VITE_API_BASE_URL=http://localhost:8000
# Same Clerk instance as CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=

# ---- Meta / Instagram ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/oauth/callback
# random string you also enter in the Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
# META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
# META_WEBHOOK_FIELDS=comments,messages
# Operators may switch supported capabilities off per environment:
# FEATURE_COMMENT_REPLY=true
# FEATURE_DM_REPLY=true
# FEATURE_PRIVATE_REPLY=true

# ---- Security ----
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated old keys, kept only while rotating:
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# ---- AI providers ----
AI_PRIMARY_PROVIDER=groq
# optional, e.g. openai
AI_FALLBACK_PROVIDER=
GROQ_API_KEY=
# Override only for a self-hosted or proxy OpenAI-compatible endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Knowledge base ----
# Max active entries per organization (plan-based limits will supersede this).
KNOWLEDGE_MAX_ENTRIES=500
# Retrieval ignores shorter words and uses at most this many distinct words of a query.
KNOWLEDGE_SEARCH_MIN_TERM_LENGTH=3
KNOWLEDGE_SEARCH_MAX_TERMS=12

# ---- DM auto-reply ----
DM_REPLY_HISTORY_MESSAGES=10
DM_REPLY_KNOWLEDGE_ENTRIES=5
DM_REPLY_KNOWLEDGE_MAX_CHARS=3000
# Instagram's DM limit; longer model output is escalated to a human, not truncated.
DM_REPLY_MAX_BYTES=1000
DM_REPLY_WINDOW_HOURS=24
DM_REPLY_JSON_OVERHEAD_TOKENS=80

# ---- Moderation (safety classifier, runs before any AI reply) ----
# Longer input is escalated to a human unclassified (Instagram caps comments at 2200 characters).
MODERATION_MAX_INPUT_CHARS=2200
MODERATION_MAX_TOKENS=60
# Below this self-reported confidence a non-threat verdict is not trusted and a human decides.
MODERATION_MIN_CONFIDENCE=0.6
# More links / mentions than this in one message is treated as spam without calling the model.
MODERATION_MAX_LINKS=2
MODERATION_MAX_MENTIONS=5

# ---- Observability ----
SENTRY_DSN=
