# ---- Runtime ----
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://instomation:instomation@localhost:5432/instomation
REDIS_URL=redis://localhost:6379/0

# ---- Workers (one process per queue: events | ai | instagram | maintenance) ----
WORKER_QUEUE=maintenance
WORKER_MAX_JOBS=10
# raise on metered Redis hosts to cut idle command usage
WORKER_POLL_DELAY_SECONDS=1.0
JOB_TIMEOUT_SECONDS=120
JOB_MAX_TRIES=5
JOB_RETRY_BASE_SECONDS=1.0
JOB_RETRY_CAP_SECONDS=300
# must exceed JOB_RETRY_CAP_SECONDS
JOB_REQUEUE_AFTER_SECONDS=900
JOB_RETENTION_DAYS=14
WEBHOOK_EVENT_RETENTION_DAYS=30

# ---- Clerk (auth) ----
# The backend verifies session tokens against Clerk's public keys, so it needs no Clerk secret key.
# https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=
# https://<your-clerk-domain>
CLERK_ISSUER=
# allowed `azp` origins (frontend URLs)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# How long the key set is cached, the shortest gap between refetches (limits abuse of unknown key
# ids), and tolerated clock difference when checking token times.
CLERK_JWKS_CACHE_SECONDS=3600
CLERK_JWKS_MIN_REFETCH_SECONDS=30
CLERK_CLOCK_SKEW_SECONDS=10

# ---- Frontend (build-time, public values only) ----
# Browser-reachable URL of the API
VITE_API_BASE_URL=http://localhost:8000
# Publishable key of the same Clerk instance as CLERK_JWKS_URL / CLERK_ISSUER
VITE_CLERK_PUBLISHABLE_KEY=

# ---- Meta / Instagram ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/oauth/callback
# random string you also enter in the Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
# META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
# META_WEBHOOK_FIELDS=comments,messages
# Operators may switch supported capabilities off per environment:
# FEATURE_COMMENT_REPLY=true
# FEATURE_DM_REPLY=true
# FEATURE_PRIVATE_REPLY=true  # also needs the organization's own private_reply_enabled setting

# ---- Security ----
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated old keys, kept only while rotating:
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# ---- AI providers ----
AI_PRIMARY_PROVIDER=groq
# optional, e.g. openai
AI_FALLBACK_PROVIDER=
GROQ_API_KEY=
# Override only for a self-hosted or proxy OpenAI-compatible endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Knowledge base ----
# Max active entries per organization (plan-based limits will supersede this).
KNOWLEDGE_MAX_ENTRIES=500
# Retrieval ignores shorter words and uses at most this many distinct words of a query.
KNOWLEDGE_SEARCH_MIN_TERM_LENGTH=3
KNOWLEDGE_SEARCH_MAX_TERMS=12

# ---- Workers ----
# Liveness key refresh; a stuck worker fails `arq app.workers.settings.WorkerSettings --check` this fast.
WORKER_HEALTH_CHECK_SECONDS=30

# ---- DM auto-reply ----
DM_REPLY_HISTORY_MESSAGES=10
DM_REPLY_KNOWLEDGE_ENTRIES=5
DM_REPLY_KNOWLEDGE_MAX_CHARS=3000
# Instagram's DM limit; longer model output is escalated to a human, not truncated.
DM_REPLY_MAX_BYTES=1000
DM_REPLY_WINDOW_HOURS=24
DM_REPLY_JSON_OVERHEAD_TOKENS=80

# ---- Comment auto-reply ----
# Comments older than this are not answered (e.g. after an outage). At most 168: Meta rejects a
# private reply to a comment older than 7 days.
COMMENT_REPLY_WINDOW_HOURS=72
# Public replies longer than this are escalated to a human, not truncated.
COMMENT_REPLY_MAX_CHARS=300

# ---- Moderation (safety classifier, runs before any AI reply) ----
# Longer input is escalated to a human unclassified (Instagram caps comments at 2200 characters).
MODERATION_MAX_INPUT_CHARS=2200
MODERATION_MAX_TOKENS=60
# Below this self-reported confidence a non-threat verdict is not trusted and a human decides.
MODERATION_MIN_CONFIDENCE=0.6
# More links / mentions than this in one message is treated as spam without calling the model.
MODERATION_MAX_LINKS=2
MODERATION_MAX_MENTIONS=5

# ---- Database pool (per process: the API and each worker keep their own pool) ----
# Total Postgres connections ~= (DB_POOL_SIZE + DB_MAX_OVERFLOW) x (API + 4 workers); mind the plan's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# A request waits this long for a free connection, then gets a fast 503 (Retry-After) instead of queueing.
DB_POOL_TIMEOUT_SECONDS=10.0
# Longest one API query may run, in ms; the query is cancelled and the request gets a 503. 0 disables.
# Workers are bounded by JOB_TIMEOUT_SECONDS instead. Applied with a plain SET, so it works behind poolers.
DB_STATEMENT_TIMEOUT_MS=15000

# ---- Abuse protection ----
# Reverse proxies in front of the API that each append to X-Forwarded-For (0 = none, e.g. the API is
# exposed directly). Set the exact number: too high lets a client pick its own address and dodge limits.
TRUSTED_PROXY_COUNT=0
# Larger request bodies are refused with 413 before they are read (Meta webhook batches are well below).
MAX_REQUEST_BODY_BYTES=2097152
# A coarse per-address flood guard (health checks and the Meta webhook are exempt). Many members can share
# one office address, so keep it generous; the per-member limit below is the one that bites.
RATE_LIMIT_PER_MINUTE_PER_IP=600
# Per signed-in member, across all their tabs. The app polls (inbox, handoffs), so allow headroom.
RATE_LIMIT_PER_MINUTE_PER_USER=120

# ---- Instagram / Meta ----
META_HTTP_TIMEOUT_SECONDS=10.0
# Where the browser lands (on FRONTEND_BASE_URL) after the Instagram OAuth round trip
OAUTH_RESULT_PATH=/settings/instagram
OAUTH_STATE_TTL_SECONDS=600
# Refresh long-lived tokens when they have this many days left
TOKEN_REFRESH_WINDOW_DAYS=10

# ---- AI models and limits ----
# Models must have an entry in app/services/ai/pricing.py or their cost is reported as unpriced.
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20.0
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=1.0
AI_RETRY_CAP_SECONDS=20.0
# Circuit breaker: open a provider after this many consecutive failures, for this long
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=60
# Requests per minute across the whole deployment, and per organization. One DM costs two calls
# (safety check + reply), so 20 per tenant is about 10 conversations a minute. Match your provider's limit.
AI_RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE_PER_TENANT=20
AI_DEFAULT_MAX_TOKENS=300
